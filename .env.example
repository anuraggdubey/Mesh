# Copy to .env.local (Next.js) and .env (workers). NEVER commit real values.
# Contract addresses and public IDs are safe to commit; private keys are not.

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL both laptops can reach (LAN IP, hotspot IP, or tunnel). Workers use this.
API_PUBLIC_URL=http://localhost:3000

# ── Hedera testnet (EVM JSON-RPC) ──
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_RPC_URL_FALLBACK=
HEDERA_CHAIN_ID=296
HEDERA_NETWORK=testnet
# HCS audit log: create the topic once with `npm run hcs:create-topic`, then paste its id. Posts are signed by API_PRIVATE_KEY.
HCS_TOPIC_ID=

# ── Keys (SECRET) ──
DEPLOYER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
FACILITATOR_PRIVATE_KEY=
# Scripted agent requester wallet
AGENT_PRIVATE_KEY=
# Provider wallet (used by the provider worker on Misbah's machine)
PROVIDER_PRIVATE_KEY=

# ── Deployed contracts (public, fine to commit once deployed) ──
RECEIPT_ADDRESS=0x0118652ea87a8616Cb51979F5F121FC598bf3e7E
STAKE_ADDRESS=0x522C2eef0EF65d1f9eA9dfe12b88ba24565245f8
ESCROW_ADDRESS=0x16eFE46De1CdA06Be455607A63514319aE130010
PAYMENT_TOKEN_ADDRESS=0x9009A5B2070a97aAa81c6EB77A2507273Ba46Ee3

# ── x402 on Hedera (POST /api/jobs charges per job). Needs API_PRIVATE_KEY (the treasury) funded with HBAR ──
X402_ENABLED=false
# Empty = the public x402 facilitator, which pays the Hedera fee for the client
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=hedera:testnet
# Treasury ACCOUNT id (0.0.x) that receives payments. Empty = the API wallet's own Hedera account.
X402_PAY_TO=
# 0.0.0 = HBAR (no token association needed). An HTS token id such as testnet USDC 0.0.429274 also works.
X402_ASSET=0.0.0

# ── Scripted agent (npm run agent -- tiny small): pays over x402, no human click ──
# AGENT_PRIVATE_KEY above must be an ECDSA key whose Hedera account holds HBAR.
# AGENT_HEDERA_ACCOUNT_ID=0.0.1234      # optional; looked up from the key's EVM address if empty
# AGENT_BUDGET=1000000                  # total it may spend per run, in job price units (0.1 = 100000)
# AGENT_JOB_CAP=500000                  # most one job may cost
# AGENT_PRESETS=tiny,small              # presets it may buy
# AGENT_ALLOWED_PAY_TO=0.0.1234         # only pay these accounts (comma separated)
# MESH_API_URL=http://localhost:3000    # defaults to API_PUBLIC_URL

# ── Verifier verdicts (POST /api/verifier/verdict) are signed by the verifier key. Empty = read from the receipt contract ──
VERIFIER_ADDRESS=

# ── 0G Private Computer ──
OG_API_KEY=
OG_API_BASE_URL=
OG_SIGNER_ADDRESS=

# ── Local storage ──
DATA_DIR=./data

# ── Workers (provider / verifier) ──
PROVIDER_CPUS=4
PROVIDER_MEMORY=4g
JOB_TIMEOUT_SECONDS=120
VERIFIER_POLL_MS=10000
VERIFIER_SAMPLE_RATE=0.25
# Enables verifier contract writes and signed API verdict reports. Keep false until the verifier key is verified and funded.
VERIFIER_SUBMIT_TRANSACTIONS=false
# Dev only: corrupt a % of tiles so the verifier can catch it. Keep false.
MESH_TAMPER=false
MESH_TAMPER_PERCENT=20

# ── API server (src/app/api) ──
# Render image the providers must run. Misbah sets the real digest after building the image.
RENDER_IMAGE_REF=mesh/render:dev
RENDER_IMAGE_DIGEST=
# Unpaid (created) jobs expire after this many seconds
UNPAID_JOB_TTL_SECONDS=300
# DEV ONLY: skip the x402 payment step and mark jobs paid. NEVER enable for the demo or production.
MESH_DEV_SKIP_PAYMENT=false

# ── Mock provider (workers/mock-provider, dev only) ──
# MOCK_API_URL=http://localhost:3000
# MOCK_PROVIDER_PRIVATE_KEY=   # optional; an ephemeral wallet is generated if unset
# MOCK_TILE_DELAY_MS=150

# DEV ONLY: register providers on chain without a World ID proof (placeholder nullifier). NEVER for the demo.
MESH_DEV_SKIP_WORLD=false
# Backend wallet for the contracts' onlyApi functions (SECRET; same key as API_ADDRESS)
# API_PRIVATE_KEY=

# ── Chain loop (lock escrow -> post claim -> finalize). Off unless true; needs API_PRIVATE_KEY and the contract addresses ──
MESH_CHAIN_LOOP=false
CHAIN_TICK_SECONDS=3
# DEV ONLY: finalize without a verifier verdict (no spot-check). NEVER for the demo.
MESH_DEV_AUTO_APPROVE=false

# ── World ID (IDKit): one human, one provider profile. Create an app at developer.world.org ──
NEXT_PUBLIC_WORLD_APP_ID=
WORLD_RP_ID=
# SECRET: the RP signing key from the portal
WORLD_SIGNING_KEY=
# Pinned on the server. "staging" only with the simulator (simulator.worldcoin.org).
WORLD_ENVIRONMENT=production
# Provider machine: the IDKit proof (JSON) for this wallet, from the verify page
# PROVIDER_WORLD_PROOF=

# ── World Agent Pass (World IdP device grant): human approval above a spending threshold. Portal: auth.world.org/portal ──
WORLD_IDP_ISSUER=https://auth.world.org
WORLD_IDP_CLIENT_ID=
# SECRET: shown once in the portal, starts with worldidp_client_secret_
WORLD_IDP_CLIENT_SECRET=
# How the portal client authenticates: post (secret in the body) or basic (HTTP Basic). Match the portal's choice.
WORLD_IDP_CLIENT_AUTH=post
WORLD_IDP_ALLOWED_ACR=https://world.org/oidc/acr/orb
# A job priced above this (token smallest unit; 1000000 = 1 mUSD) needs a fresh human approval. Empty = never.
AGENT_APPROVAL_THRESHOLD=
AGENT_APPROVAL_MAX_AGE_SECONDS=300
