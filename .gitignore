# ───────── Dependencies ─────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ───────── Next.js / build output ─────────
/.next/
/out/
/build
dist/
*.tsbuildinfo
next-env.d.ts

# ───────── Secrets (NEVER commit) ─────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
keystore/
secrets/
wallets/
*.mnemonic
private-key*
privatekey*
hedera-keys*
provider-world-proof.json
.hedera/

# ───────── Foundry (contracts/) ─────────
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/cache_hardhat/
# contracts/lib/ is installed via `forge install` (git submodules); keep it tracked.

# ───────── Mesh runtime data ─────────
# Local DB, job inputs/outputs, tile blobs, worker scratch space
/data/
/.mesh/
/workspaces/
/job-workspace/
/tmp/
/temp/
*.sqlite
*.sqlite3
*.db
*.db-journal

# Rendered / generated job output (large binaries). Anchored to the repo root on purpose:
# an unanchored `tiles/` would also hide the source folder src/app/api/jobs/[id]/tiles.
/output/
/outputs/
/tiles/
*.tile
/renders/

# Docker image exports
*.tar
*.tar.gz
docker-compose.override.yml

# ───────── Logs ─────────
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ───────── Tests / coverage ─────────
/coverage
.nyc_output/
.vitest-cache/

